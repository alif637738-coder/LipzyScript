	Knob.ZIndex = Track.ZIndex + 2
	Knob.Parent = Track

	local KnobCorner = Instance.new("UICorner")
	KnobCorner.CornerRadius = UDim.new(1, 0)
	KnobCorner.Parent = Knob

	local state = false
	local function SetVisualState(isOn, instant)
		state = isOn
		local targetPos = isOn and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11)
		local targetKnobColor = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(185, 185, 200)
		local targetTransp = isOn and 0 or 1
		local targetStrokeColor = isOn and Color3.fromRGB(255, 255, 255) or Color3.fromRGB(95, 95, 115)

		FillGrad.Enabled = isOn

		if instant then
			Knob.Position = targetPos
			Knob.BackgroundColor3 = targetKnobColor
			ActiveFill.BackgroundTransparency = targetTransp
			TrackStroke.Color = targetStrokeColor
		else
			local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
			TweenService:Create(Knob, info, { Position = targetPos, BackgroundColor3 = targetKnobColor }):Play()
			TweenService:Create(ActiveFill, info, { BackgroundTransparency = targetTransp }):Play()
			TweenService:Create(TrackStroke, info, { Color = targetStrokeColor }):Play()
		end
	end

	Track.MouseButton1Click:Connect(function()
		state = not state
		SetVisualState(state, false)
		if onChanged then
			onChanged(state)
		end
	end)

	return {
		Button = Track,
		SetState = function(val)
			SetVisualState(val, false)
		end,
		GetState = function()
			return state
		end,
	}
end

