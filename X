local function Is2xCandidateNameOrText(str)
	local s = tostring(str or ""):lower()
	if s == "" then
		return false
	end
	if s:find("2x", 1, true) or s:find("x2", 1, true) or s:find("double", 1, true) then
		return true
	end
	return false
end

local function IsStopPullUpText(str)
	local s = tostring(str or ""):lower()
	if s == "" then
		return false
	end
	return s:find("berhenti", 1, true) ~= nil
		or s:find("stop", 1, true) ~= nil
		or s:find("cancel", 1, true) ~= nil
		or s:find("batal", 1, true) ~= nil
		or s:find("keluar", 1, true) ~= nil
		or s:find("exit", 1, true) ~= nil
end

local function Refresh2xCache(hrp)
	if not Auto2xPullUpEnabled then
		return
	end
	local foundGuis = {}
	local foundPrompts = {}
	local foundStopGuis = {}
	local roots = {}

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	pcall(function()
		if CoreGui then
			table.insert(roots, CoreGui)
		end
	end)

	for _, root in ipairs(roots) do
		pcall(function()
			for _, desc in ipairs(root:GetDescendants()) do
				if not desc:IsDescendantOf(ScreenGui) then
					if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
						if IsStopPullUpText(desc.Text) or IsStopPullUpText(desc.Name) then
							table.insert(foundStopGuis, desc)
						end
						if Is2xCandidateNameOrText(desc.Text) or Is2xCandidateNameOrText(desc.Name) then
							local targetGui = ResolveClickableGui(desc)
							if targetGui and not table.find(foundGuis, targetGui) then
								table.insert(foundGuis, targetGui)
							end
						end
					elseif desc:IsA("ImageButton") or desc:IsA("ImageLabel") then
						if Is2xCandidateNameOrText(desc.Name) or Is2xCandidateNameOrText(desc.Image) then
							local targetGui = ResolveClickableGui(desc)
							if targetGui and not table.find(foundGuis, targetGui) then
								table.insert(foundGuis, targetGui)
							end
						end
					end
				end
			end
		end)
	end

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			local meta = (tostring(obj.Name) .. " " .. tostring(obj.ActionText) .. " " .. tostring(obj.ObjectText)):lower()
			if Is2xCandidateNameOrText(meta) or meta:find("pull", 1, true) then
				local validNear = true
				if hrp then
					local pos = GetPromptWorldPos(obj)
					if pos and (pos - hrp.Position).Magnitude > 25 then
						validNear = false
					end
				end
				if validNear then
					table.insert(foundPrompts, obj)
				end
			end
		end
	end

	Cached2xGuis = foundGuis
	Cached2xPrompts = foundPrompts
	CachedStopPullUpGuis = foundStopGuis
	Last2xRescan = os.clock()
end

local function IsDoingPullUp(char, hrp, hum)
	if not Auto2xPullUpEnabled or not char or not hrp or not hum or hum.Health <= 0 then
		return false
	end

	local now = os.clock()
	if (#CachedStopPullUpGuis == 0 and #Cached2xGuis == 0) or (now - Last2xRescan) >= 1.5 then
		Refresh2xCache(hrp)
	end

	for i = #CachedStopPullUpGuis, 1, -1 do
		local g = CachedStopPullUpGuis[i]
		if not g or not g.Parent then
			table.remove(CachedStopPullUpGuis, i)
		elseif IsGuiActuallyVisible(g) and IsStopPullUpText(g.Text) then
			return true
		end
	end

	if char:GetAttribute("PullUp") == true or char:GetAttribute("IsPullUp") == true or char:GetAttribute("Training") == true then
		return true
	end

	for _, child in ipairs(char:GetChildren()) do
		if child:IsA("Tool") then
			local tName = child.Name:lower()
			if tName:find("pull", 1, true) or tName:find("bar", 1, true) then
				return true
			end
		end
	end

	return false
end

local function Detect2xTarget(hrp)
	if not Auto2xPullUpEnabled then
		return nil, nil
	end
	local now = os.clock()
	if (#Cached2xGuis == 0 and #Cached2xPrompts == 0) or (now - Last2xRescan) >= 1.5 then
		Refresh2xCache(hrp)
	end

	local activeGui = nil
	for i = #Cached2xGuis, 1, -1 do
		local g = Cached2xGuis[i]
		if not g or not g.Parent then
			table.remove(Cached2xGuis, i)
		elseif IsGuiActuallyVisible(g) and g:IsA("GuiObject") and g.AbsoluteSize.X > 4 and g.AbsoluteSize.Y > 4 then
			activeGui = g
			break
		end
	end

	local activePrompt = nil
	for i = #Cached2xPrompts, 1, -1 do
		local pr = Cached2xPrompts[i]
		if not pr or not pr.Parent then
			table.remove(Cached2xPrompts, i)
		elseif pr.Enabled then
			activePrompt = pr
			break
		end
	end

	return activeGui, activePrompt
end

local function Trigger2xWithProximity(targetGui, targetPrompt)
	if not Auto2xPullUpEnabled then
		return
	end
	if targetPrompt and targetPrompt.Parent and targetPrompt.Enabled then
		FireSinglePrompt(targetPrompt)
	end

	if not Auto2xPullUpEnabled then
		return
	end

	if targetGui and targetGui:IsA("GuiObject") and IsGuiActuallyVisible(targetGui) and targetGui.AbsoluteSize.X > 0 and targetGui.AbsoluteSize.Y > 0 then
		local cx = targetGui.AbsolutePosition.X + (targetGui.AbsoluteSize.X * 0.5)
		local cy = targetGui.AbsolutePosition.Y + (targetGui.AbsoluteSize.Y * 0.5)

		if targetGui:IsA("GuiButton") then
			FireGuiButtonConnections(targetGui)
		end

		SilentBackgroundClick(cx, cy)
	end
end

local function IsThrowLineColor(color)
	return (color.R >= 0.72 and color.G >= 0.35 and color.B <= 0.38)
end

local function BuildWorldCache(hrp)
	if not AutoThrowEnabled then
		return
	end
	local candidateParts = {}
	local namedZones = {}
	local prompts = {}
	local throwPrompts = {}

	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("BasePart") and obj.Anchored then
			local nameLower = obj.Name:lower()
			if nameLower:find("throw") or nameLower:find("start") or nameLower:find("launch") then
				if obj.Size.X >= 6 or obj.Size.Z >= 6 then
					table.insert(namedZones, obj)
				end
			end

			local isFlatStrip = (obj.Size.Y <= 3.5) and (math.max(obj.Size.X, obj.Size.Z) >= 8)
			if isFlatStrip and IsThrowLineColor(obj.Color) then
				table.insert(candidateParts, obj)
			end
		elseif obj:IsA("ProximityPrompt") then
			table.insert(prompts, obj)
			if IsThrowProximityPrompt(obj) then
				table.insert(throwPrompts, obj)
			end
		end
	end

	CachedAllPrompts = prompts
	CachedThrowPrompts = throwPrompts
	LastPromptCacheScan = os.clock()

	local foundCFrame = nil
	if #namedZones > 0 then
		local bestPart = namedZones[1]
		local bestDist = (bestPart.Position - hrp.Position).Magnitude
		for _, p in ipairs(namedZones) do
			local d = (p.Position - hrp.Position).Magnitude
			if d < bestDist then
				bestDist = d
				bestPart = p
			end
		end
		local topY = bestPart.Position.Y + (bestPart.Size.Y * 0.5) + 3.2
		foundCFrame = CFrame.new(bestPart.Position.X, topY, bestPart.Position.Z)
	elseif #candidateParts > 0 then
		local anchor = candidateParts[1]
		local minDist = (anchor.Position - hrp.Position).Magnitude
		for _, p in ipairs(candidateParts) do
			local d = (p.Position - hrp.Position).Magnitude
			if d < minDist then
				minDist = d
				anchor = p
			end
		end

		local sumPos = Vector3.zero
		local count = 0
		local maxTopY = anchor.Position.Y + (anchor.Size.Y * 0.5)

		for _, p in ipairs(candidateParts) do
			if math.abs(p.Position.Y - anchor.Position.Y) <= 4 and (p.Position - anchor.Position).Magnitude <= 80 then
				sumPos += p.Position
				count += 1
				local top = p.Position.Y + (p.Size.Y * 0.5)
				if top > maxTopY then
					maxTopY = top
				end
			end
		end

		if count > 0 then
			local avgCenter = sumPos / count
			foundCFrame = CFrame.new(avgCenter.X, maxTopY + 3.2, avgCenter.Z)
		end
	end

	local filteredPrompts = {}
	if foundCFrame then
		for _, prompt in ipairs(prompts) do
			local pos = GetPromptWorldPos(prompt)
			if pos then
				local distZone = Vector2.new(pos.X - foundCFrame.Position.X, pos.Z - foundCFrame.Position.Z).Magnitude
				if distZone <= 20 and not (tostring(prompt.Name):lower():find("pull", 1, true)) then
					HidePromptVisual(prompt)
					table.insert(filteredPrompts, { prompt = prompt, pos = pos })
				end
			end
		end
	end

	CachedThrowCFrame = foundCFrame
	CachedZonePrompts = filteredPrompts

	if IsCameraLockShouldBeActive() and CachedThrowCFrame then
		LockedCameraCFrame = ComputeThrowFrontLockCFrame(workspace.CurrentCamera)
		EnforceLockedCamera()
	end
end

local function RefreshLuckLabelsCache()
	if not AutoThrowEnabled then
		return
	end
	local labels = {}
	local roots = {}

	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	pcall(function()
		if CoreGui then
			table.insert(roots, CoreGui)
		end
	end)

	for _, root in ipairs(roots) do
		local okScan = pcall(function()
			for _, desc in ipairs(root:GetDescendants()) do
				RegisterSkipCandidate(desc)
				if desc:IsA("TextLabel") or desc:IsA("TextButton") or desc:IsA("TextBox") then
					if desc.Name ~= "Title" and not desc:IsDescendantOf(ScreenGui) then
						local txt = tostring(desc.Text or "")
						if txt:find("%+") then
							table.insert(labels, desc)
						end
					end
				end
			end
		end)
		if not okScan then
			continue
		end
	end

	CachedLuckLabels = labels
	LastLuckRescan = os.clock()
end

local function DetectSkipPromptTextFast()
	if not AutoThrowEnabled or not SkipAnimationEnabled then
		return nil
	end

	SeedSkipWatchlist(false)

	local phase1Fallback = nil
	for i = #WatchedSkipLabels, 1, -1 do
		local lbl = WatchedSkipLabels[i]
		if not lbl or not lbl.Parent then
			table.remove(WatchedSkipLabels, i)
		else
			local phase = GetSkipPhase(lbl.Text)
			if phase > 0 and IsGuiActuallyVisible(lbl) then
				if phase == 2 then
					return lbl
				end
				phase1Fallback = phase1Fallback or lbl
			end
		end
	end

	return phase1Fallback
end

local function DetectPlusThrowNumber()
	if not AutoThrowEnabled then
		return nil
	end
	local now = os.clock()
	if #CachedLuckLabels == 0 or (now - LastLuckRescan) >= 1.5 then
		RefreshLuckLabelsCache()
	end

	for i = #CachedLuckLabels, 1, -1 do
		local lbl = CachedLuckLabels[i]
		if not lbl or not lbl.Parent then
			table.remove(CachedLuckLabels, i)
		elseif IsGuiActuallyVisible(lbl) then
			local txt = tostring(lbl.Text or "")
			local numStr = txt:match("^%+%s*(%d+)$") or txt:match("^%+(%d+)")
			if numStr then
				local n = tonumber(numStr)
				if n and TargetNumbers[n] then
					return n
				end
			end
		end
	end

	return nil
end

local function IsInThrowZone(hrp, zoneCFrame)
	if not hrp or not zoneCFrame then
		return false
	end
	local horizontalDist = Vector2.new(hrp.Position.X - zoneCFrame.Position.X, hrp.Position.Z - zoneCFrame.Position.Z).Magnitude
	local verticalDiff = math.abs(hrp.Position.Y - zoneCFrame.Position.Y)
	return (horizontalDist <= 10) and (verticalDiff <= 5)
end

local function TeleportToZone(hrp, zoneCFrame)
	if not AutoThrowEnabled or not hrp or not zoneCFrame then
		return false
	end
	pcall(function()
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = zoneCFrame
	end)
	return IsInThrowZone(hrp, zoneCFrame)
end

local function FireThrowNow(hrp, zoneCFrame, allowPrompt)
	if not AutoThrowEnabled then
		return
	end
	if allowPrompt then
		FireThrowProximityPrompts(hrp, zoneCFrame)
	end

	if not AutoThrowEnabled then
		return
	end

	local cam = workspace.CurrentCamera
	if cam then
		local x, y = cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5
		SilentBackgroundClick(x, y)
	end
end

local function StepAutoRunAnywhere(hum, hrp)
	if not AutoThrowEnabled or not hum or not hrp then
		return
	end

	local now = os.clock()
	if not CurrentRunTarget or now >= NextRunPickTime then
		local angle = RNG:NextNumber(0, math.pi * 2)
		local dist = RNG:NextNumber(14, 28)
		CurrentRunTarget = hrp.Position + Vector3.new(
			math.cos(angle) * dist,
			0,
			math.sin(angle) * dist
		)
		NextRunPickTime = now + 0.9
	end

	pcall(function()
		if hum.WalkSpeed < 16 then
			hum.WalkSpeed = 16
		end
		hum:MoveTo(CurrentRunTarget)
	end)
end

RunService.Heartbeat:Connect(function()
	local t = os.clock()
	for _, entry in ipairs(RainbowGradients) do
		if entry.gradient and entry.gradient.Parent then
			entry.gradient.Rotation = (entry.offset + (t * 65)) % 360
		end
	end

	if IsCameraLockShouldBeActive() then
		PreventBlackScreenOverlays(false)
	end

	if not AutoThrowEnabled and not Auto2xPullUpEnabled then
		return
	end

	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.Health <= 0 then
		return
	end

	local now = os.clock()

	if Auto2xPullUpEnabled and not Is2xBusy and (now - Last2xClaimTime) >= CLAIM_2X_COOLDOWN then
		if IsDoingPullUp(char, hrp, hum) then
			local target2xGui, target2xPrompt = Detect2xTarget(hrp)
			if target2xGui or target2xPrompt then
				Is2xBusy = true
				Last2xClaimTime = now
				task.spawn(function()
					if Auto2xPullUpEnabled then
						Trigger2xWithProximity(target2xGui, target2xPrompt)
					end
					task.wait(0.08)
					Is2xBusy = false
				end)
			end
		end
	end

	if not AutoThrowEnabled then
		return
	end

	if SkipAnimationEnabled and not IsTriggerBusy and (now - LastReflexSkipTime) >= REFLEX_SKIP_COOLDOWN then
		local skipGui = DetectSkipPromptTextFast()
		if skipGui then
			IsTriggerBusy = true
			FireSkipReflexNow(skipGui)
			IsTriggerBusy = false
			return
		end
	end

	if IsTriggerBusy or (now - LastTriggerTime) < TRIGGER_COOLDOWN then
		return
	end

	if not CachedThrowCFrame then
		BuildWorldCache(hrp)
	end

	local detected = DetectPlusThrowNumber()
	if detected then
		IsTriggerBusy = true
		LastTriggerTime = now

		task.spawn(function()
			if AutoThrowEnabled then
				local inZone = IsInThrowZone(hrp, CachedThrowCFrame)
				if not inZone and CachedThrowCFrame then
					inZone = TeleportToZone(hrp, CachedThrowCFrame)
				end
				FireThrowNow(hrp, CachedThrowCFrame, inZone)
			end
			task.wait(0.06)
			IsTriggerBusy = false
		end)
	end
end)

task.spawn(function()
	while ScreenGui and ScreenGui.Parent do
		if AutoThrowEnabled then
			local char = LocalPlayer.Character
			local hrp = char and char:FindFirstChild("HumanoidRootPart")
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			if hrp and hum and hum.Health > 0 and AutoThrowEnabled then
				if not CachedThrowCFrame then
					BuildWorldCache(hrp)
				end

				if not IsTriggerBusy and AutoThrowEnabled then
					if CachedThrowCFrame and not IsInThrowZone(hrp, CachedThrowCFrame) then
						TeleportToZone(hrp, CachedThrowCFrame)
					end

					if AutoThrowEnabled and (hrp.AssemblyLinearVelocity.Magnitude < 2.5 or not CurrentRunTarget or os.clock() >= NextRunPickTime) then
						StepAutoRunAnywhere(hum, hrp)
					end
				end
			end
		else
			CurrentRunTarget = nil
			NextRunPickTime = 0
		end
		task.wait(0.2)
	end
end)
