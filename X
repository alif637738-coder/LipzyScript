local RainbowSequence = ColorSequence.new({
	ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255, 65, 65)),
	ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 175, 50)),
	ColorSequenceKeypoint.new(0.33, Color3.fromRGB(90, 255, 110)),
	ColorSequenceKeypoint.new(0.50, Color3.fromRGB(55, 220, 255)),
	ColorSequenceKeypoint.new(0.67, Color3.fromRGB(95, 115, 255)),
	ColorSequenceKeypoint.new(0.83, Color3.fromRGB(215, 75, 255)),
	ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255, 65, 65)),
})

local RainbowGradients = {}
local function ApplyRainbowGradient(parent, rotationOffset)
	local grad = Instance.new("UIGradient")
	grad.Color = RainbowSequence
	grad.Rotation = rotationOffset or 0
	grad.Parent = parent
	table.insert(RainbowGradients, {
		gradient = grad,
		offset = rotationOffset or 0,
	})
	return grad
end

