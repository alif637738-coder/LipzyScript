local function IsGuiActuallyVisible(guiObj)
	local curr = guiObj
	while curr do
		if curr:IsA("GuiObject") and not curr.Visible then
			return false
		end
		if curr:IsA("LayerCollector") and not curr.Enabled then
			return false
		end
		curr = curr.Parent
	end
	return true
end

local function HidePromptVisual(prompt)
	if not prompt or not prompt.Parent then
		return
	end
	pcall(function()
		prompt.Style = Enum.ProximityPromptStyle.Custom
		prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 18)
	end)
end

local function GetPromptWorldPos(prompt)
	if not prompt or not prompt.Parent then
		return nil
	end
	local p = prompt.Parent
	if p:IsA("BasePart") then
		return p.Position
	elseif p:IsA("Model") then
		return p:GetPivot().Position
	elseif p:IsA("Attachment") then
		return p.WorldPosition
	end
	return nil
end

local function IsThrowProximityPrompt(prompt)
	if not prompt or not prompt:IsA("ProximityPrompt") then
		return false
	end
	local meta = (tostring(prompt.Name) .. " " .. tostring(prompt.ActionText) .. " " .. tostring(prompt.ObjectText)):lower()
	if meta:find("pull", 1, true) or meta:find("2x", 1, true) or meta:find("x2", 1, true) then
		return false
	end
	if meta:find("throw", 1, true)
		or meta:find("lempar", 1, true)
		or meta:find("klik", 1, true)
		or meta:find("click", 1, true)
		or meta:find("start", 1, true)
		or meta:find("launch", 1, true) then
		return true
	end
	return false
end

local function RefreshPromptCacheLight(force)
	local now = os.clock()
	if not force and (now - LastPromptCacheScan) < 2.0 then
		return
	end
	LastPromptCacheScan = now

	local allList = {}
	local throwList = {}
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("ProximityPrompt") then
			table.insert(allList, obj)
			if IsThrowProximityPrompt(obj) then
				table.insert(throwList, obj)
			end
		end
	end
	CachedAllPrompts = allList
	CachedThrowPrompts = throwList
end

local function FireSinglePrompt(prompt)
	if not prompt or not prompt.Parent or not prompt.Enabled then
		return false
	end
	HidePromptVisual(prompt)
	local ok = pcall(function()
		if fireproximityprompt then
			fireproximityprompt(prompt)
		else
			prompt:InputHoldBegin()
			task.wait(PROMPT_CLICK_DELAY)
			prompt:InputHoldEnd()
		end
	end)
	return ok
end

local function FireThrowProximityPrompts(hrp, zoneCFrame)
	if not AutoThrowEnabled then
		return false
	end

	for i = #CachedZonePrompts, 1, -1 do
		local item = CachedZonePrompts[i]
		local prompt = item and item.prompt
		if not prompt or not prompt.Parent then
			table.remove(CachedZonePrompts, i)
		elseif prompt.Enabled then
			local pos = GetPromptWorldPos(prompt) or item.pos
			local nearOk = true
			if hrp and pos then
				nearOk = ((pos - hrp.Position).Magnitude <= 22)
			end
			if nearOk and FireSinglePrompt(prompt) then
				return true
			end
		end
	end

	for i = #CachedThrowPrompts, 1, -1 do
		local pr = CachedThrowPrompts[i]
		if not pr or not pr.Parent then
			table.remove(CachedThrowPrompts, i)
		elseif pr.Enabled then
			local pos = GetPromptWorldPos(pr)
			local nearOk = true
			if hrp and pos then
				nearOk = ((pos - hrp.Position).Magnitude <= 24)
			end
			if zoneCFrame and pos then
				nearOk = ((pos - zoneCFrame.Position).Magnitude <= 24)
			end
			if nearOk and FireSinglePrompt(pr) then
				return true
			end
		end
	end

	for i = #CachedAllPrompts, 1, -1 do
		local pr = CachedAllPrompts[i]
		if not pr or not pr.Parent then
			table.remove(CachedAllPrompts, i)
		elseif pr.Enabled and not IsThrowProximityPrompt(pr) then
			local meta = (tostring(pr.Name) .. " " .. tostring(pr.ActionText) .. " " .. tostring(pr.ObjectText)):lower()
			if not (meta:find("pull", 1, true) or meta:find("2x", 1, true)) then
				local pos = GetPromptWorldPos(pr)
				if hrp and pos and (pos - hrp.Position).Magnitude <= 14 then
					if FireSinglePrompt(pr) then
						return true
					end
				end
			end
		end
	end

	return false
end

local function ResolveClickableGui(obj)
	if not obj then
		return nil
	end
	if obj:IsA("GuiButton") then
		return obj
	end
	if obj:IsA("GuiObject") then
		if obj.Parent and obj.Parent:IsA("GuiButton") then
			return obj.Parent
		end
		for _, child in ipairs(obj:GetChildren()) do
			if child:IsA("GuiButton") then
				return child
			end
		end
	end
	return obj
end

local function GetSkipPhase(txt)
	local lowerTxt = tostring(txt or ""):lower()
	if lowerTxt == "" then
		return 0
	end
	if lowerTxt:find("melanjut", 1, true) ~= nil or lowerTxt:find("continue", 1, true) ~= nil then
		return 2
	end
	if lowerTxt:find("melewak", 1, true) ~= nil
		or lowerTxt:find("melewat", 1, true) ~= nil
		or lowerTxt:find("skip", 1, true) ~= nil then
		return 1
	end
	return 0
end

