local function GetCorridorDirection(cam)
	if CORRIDOR_DIR and CORRIDOR_DIR.Magnitude > 0.01 then
		local flat = Vector3.new(CORRIDOR_DIR.X, 0, CORRIDOR_DIR.Z)
		if flat.Magnitude > 0.01 then
			return flat.Unit
		end
	end
	if cam then
		local look = cam.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude > 0.01 then
			return flat.Unit
		end
	end
	return Vector3.new(0, 0, -1)
end

local function IsPlayerCharacterModel(inst)
	if not inst or not inst:IsA("Model") then
		return false
	end
	if Players:GetPlayerFromCharacter(inst) ~= nil then
		return true
	end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr.Character == inst then
			return true
		end
	end
	return false
end

local function IsDummyOrNpcModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if model == HiddenAnimalsFolder or model:IsDescendantOf(HiddenAnimalsFolder) then
		return false
	end
	if IsPlayerCharacterModel(model) then
		return false
	end
	local hum = model:FindFirstChildOfClass("Humanoid")
	local hrp = model:FindFirstChild("HumanoidRootPart") or model:FindFirstChild("Torso") or model:FindFirstChild("UpperTorso")
	if hum and hrp then
		local n = model.Name:lower()
		if n:find("dummy", 1, true)
			or n:find("clone", 1, true)
			or n:find("tiruan", 1, true)
			or n:find("npc", 1, true)
			or n:find("bot", 1, true)
			or n:find("rig", 1, true)
			or n:find("mannequin", 1, true)
			or model:GetAttribute("Dummy") == true
			or model:GetAttribute("IsDummy") == true
			or model:GetAttribute("Clone") == true then
			return true
		end
	end
	return false
end

local function IsAnimalCandidateModel(model)
	if not model or not model:IsA("Model") then
		return false
	end
	if model == HiddenAnimalsFolder or model:IsDescendantOf(HiddenAnimalsFolder) then
		return false
	end
	if IsPlayerCharacterModel(model) or IsDummyOrNpcModel(model) then
		return false
	end
	local n = model.Name:lower()
	if n:find("pet", 1, true)
		or n:find("animal", 1, true)
		or n:find("hewan", 1, true)
		or n:find("beast", 1, true)
		or n:find("creature", 1, true)
		or n:find("companion", 1, true)
		or n:find("buddy", 1, true)
		or n:find("minion", 1, true) then
		return true
	end
	if model:GetAttribute("Pet") == true or model:GetAttribute("IsPet") == true or model:GetAttribute("Animal") == true then
		return true
	end
	return false
end

local function HideSingleAnimalModel(model)
	if not model or not model.Parent or RemovedAnimalRecords[model] then
		return
	end
	if not IsAnimalCandidateModel(model) then
		return
	end
	local origParent = model.Parent
	RemovedAnimalRecords[model] = {
		Parent = origParent,
	}
	pcall(function()
		model.Parent = HiddenAnimalsFolder
	end)
end

local function RemoveAllGameAnimals()
	for _, desc in ipairs(workspace:GetDescendants()) do
		if desc:IsA("Model") then
			HideSingleAnimalModel(desc)
		end
	end
	if not AnimalWatcherConn then
		AnimalWatcherConn = workspace.DescendantAdded:Connect(function(desc)
			if RemoveCharacterEnabled and desc:IsA("Model") then
				task.defer(function()
					if RemoveCharacterEnabled then
						HideSingleAnimalModel(desc)
					end
				end)
			end
		end)
	end
end

local function RestoreAllGameAnimals()
	if AnimalWatcherConn then
		pcall(function()
			AnimalWatcherConn:Disconnect()
		end)
		AnimalWatcherConn = nil
	end
	for model, rec in pairs(RemovedAnimalRecords) do
		if model and rec and rec.Parent and rec.Parent.Parent then
			pcall(function()
				model.Parent = rec.Parent
			end)
		end
	end
	RemovedAnimalRecords = {}
end

local function ClearCharWatchers()
	for _, conn in ipairs(CharWatcherConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	CharWatcherConns = {}
end

local function HideModelVisualOnly(targetModel)
	if not targetModel then
		return
	end
	for _, desc in ipairs(targetModel:GetDescendants()) do
		if desc:IsA("BasePart") or desc:IsA("Decal") or desc:IsA("Texture") then
			if SavedCharAppearance[desc] == nil then
				SavedCharAppearance[desc] = {
					Transparency = desc.Transparency,
					LocalTransparencyModifier = desc:IsA("BasePart") and desc.LocalTransparencyModifier or nil,
				}
			end
			pcall(function()
				desc.Transparency = 1
				if desc:IsA("BasePart") then
					desc.LocalTransparencyModifier = 1
				end
			end)
		elseif desc:IsA("BillboardGui") or desc:IsA("SurfaceGui") then
			if SavedCharAppearance[desc] == nil then
				SavedCharAppearance[desc] = {
					Enabled = desc.Enabled,
				}
			end
			pcall(function()
				desc.Enabled = false
			end)
		elseif desc:IsA("ParticleEmitter") or desc:IsA("Trail") or desc:IsA("Beam") then
			if SavedCharAppearance[desc] == nil then
				SavedCharAppearance[desc] = {
					Enabled = desc.Enabled,
				}
			end
			pcall(function()
				desc.Enabled = false
			end)
		end
	end
	local hum = targetModel:FindFirstChildOfClass("Humanoid")
	if hum then
		if SavedCharAppearance[hum] == nil then
			SavedCharAppearance[hum] = {
				DisplayDistanceType = hum.DisplayDistanceType,
				HealthDisplayType = hum.HealthDisplayType,
			}
		end
		pcall(function()
			hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			hum.HealthDisplayType = Enum.HumanoidDisplayDistanceType.AlwaysOff
		end)
	end
end

local function HideLocalCharacterVisuals(char)
	if not char then
		return
	end
	HideModelVisualOnly(char)
	for _, obj in ipairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and IsDummyOrNpcModel(obj) then
			HideModelVisualOnly(obj)
		end
	end
end

-- Fix: tidak menggeser HRP ke -18 stud agar tidak memicu bug no-clip / jatuh ke bawah
local function ParkLocalCharacterOutOfView(char)
	if not char then
		return
	end
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if hrp and hrp:IsA("BasePart") then
		if SavedCharRootCFrame == nil then
			SavedCharRootCFrame = hrp.CFrame
			SavedCharRootAnchored = hrp.Anchored
		end
		pcall(function()
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end
end

local function ApplyCharacterRemoval()
	local char = LocalPlayer.Character
	if not char then
		return
	end
	HideLocalCharacterVisuals(char)
	ParkLocalCharacterOutOfView(char)

	ClearCharWatchers()
	table.insert(CharWatcherConns, char.DescendantAdded:Connect(function(desc)
		if RemoveCharacterEnabled then
			task.defer(function()
				if RemoveCharacterEnabled and LocalPlayer.Character == char then
					HideModelVisualOnly(char)
				end
			end)
		end
	end))
	table.insert(CharWatcherConns, workspace.DescendantAdded:Connect(function(desc)
		if RemoveCharacterEnabled and desc:IsA("Model") and IsDummyOrNpcModel(desc) then
			task.defer(function()
				if RemoveCharacterEnabled then
					HideModelVisualOnly(desc)
				end
			end)
		end
	end))
end

local function RestoreLocalCharacter()
	ClearCharWatchers()
	local char = LocalPlayer.Character

	for inst, prev in pairs(SavedCharAppearance) do
		if inst and inst.Parent then
			pcall(function()
				if inst:IsA("BasePart") then
					inst.Transparency = prev.Transparency
					if prev.LocalTransparencyModifier ~= nil then
						inst.LocalTransparencyModifier = prev.LocalTransparencyModifier
					end
				elseif inst:IsA("Decal") or inst:IsA("Texture") then
					inst.Transparency = prev.Transparency
				elseif inst:IsA("BillboardGui") or inst:IsA("SurfaceGui") or inst:IsA("ParticleEmitter") or inst:IsA("Trail") or inst:IsA("Beam") then
					inst.Enabled = prev.Enabled
				elseif inst:IsA("Humanoid") then
					inst.DisplayDistanceType = prev.DisplayDistanceType
					inst.HealthDisplayType = prev.HealthDisplayType
				end
			end)
		end
	end
	SavedCharAppearance = {}

	if char then
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if hrp and hrp:IsA("BasePart") then
			pcall(function()
				hrp.AssemblyLinearVelocity = Vector3.zero
				hrp.AssemblyAngularVelocity = Vector3.zero
				if SavedCharRootAnchored ~= nil then
					hrp.Anchored = SavedCharRootAnchored
				end
			end)
		end
	end
	SavedCharRootCFrame = nil
	SavedCharRootAnchored = nil
end

local function SyncCharacterAndAnimalRemoval()
	if RemoveCharacterEnabled then
		RemoveAllGameAnimals()
		ApplyCharacterRemoval()
	else
		RestoreLocalCharacter()
		RestoreAllGameAnimals()
	end
end

