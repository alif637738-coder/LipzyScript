local BOX_SMOOTH_ALPHA = 0.45

local function GetCharacterBounds3D(char)
	local okBox, cf, size = pcall(function()
		return char:GetBoundingBox()
	end)

	if okBox and cf and size and size.Magnitude > 0.1 then
		local halfH = math.clamp(size.Y * 0.5, 1.4, 5.5)
		local center = cf.Position
		local topWorld = Vector3.new(center.X, center.Y + halfH, center.Z)
		local bottomWorld = Vector3.new(center.X, center.Y - halfH, center.Z)
		return center, topWorld, bottomWorld, halfH * 2
	end

	local fallbackPart = char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("Head")
		or char:FindFirstChildWhichIsA("BasePart")

	if not fallbackPart then
		return nil, nil, nil, nil
	end

	local pos = fallbackPart.Position
	local topWorld = pos + Vector3.new(0, 2.75, 0)
	local bottomWorld = pos - Vector3.new(0, 3.05, 0)
	return pos, topWorld, bottomWorld, 5.8
end

local function ComputeCharacterBoxScreenRect(char, cam)
	local centerWorld, topWorld, bottomWorld, worldHeight = GetCharacterBounds3D(char)
	if not centerWorld then
		return nil
	end

	local topScreen, topVis = cam:WorldToViewportPoint(topWorld)
	local botScreen, botVis = cam:WorldToViewportPoint(bottomWorld)
	local ctrScreen, ctrVis = cam:WorldToViewportPoint(centerWorld)

	if ctrScreen.Z <= 0.05 and not topVis and not botVis and not ctrVis then
		return nil
	end

	local boxHeight
	if topScreen.Z > 0.05 and botScreen.Z > 0.05 then
		boxHeight = math.abs(botScreen.Y - topScreen.Y)
	else
		local dist = math.max(1, ctrScreen.Z > 0.05 and ctrScreen.Z or (cam.CFrame.Position - centerWorld).Magnitude)
		local fovRad = math.rad(cam.FieldOfView)
		boxHeight = (worldHeight / (2 * dist * math.tan(fovRad * 0.5))) * cam.ViewportSize.Y
	end

	boxHeight = math.clamp(boxHeight, 16, 460)
	local boxWidth = math.clamp(boxHeight * 0.42, 10, 220)

	local centerX = (ctrScreen.Z > 0.05) and ctrScreen.X or ((topScreen.X + botScreen.X) * 0.5)
	local centerY = (topScreen.Z > 0.05 and botScreen.Z > 0.05) and ((topScreen.Y + botScreen.Y) * 0.5) or ctrScreen.Y

	return centerX - (boxWidth * 0.5), centerY - (boxHeight * 0.5), boxWidth, boxHeight
end

local function GetOrCreatePlayerEsp(plr)
	if not HasDrawingApi then
		return nil
	end
	local pack = PlayerEspDrawings[plr]
	if pack then
		return pack
	end

	local box = Drawing.new("Square")
	box.Visible = false
	box.Filled = false
	box.Thickness = 1.8
	box.Transparency = 1

	local line = Drawing.new("Line")
	line.Visible = false
	line.Thickness = 1.5
	line.Transparency = 1

	local bones = {}
	for _ = 1, #SKELETON_PAIRS_R15 do
		local bLine = Drawing.new("Line")
		bLine.Visible = false
		bLine.Color = Color3.fromRGB(255, 255, 255)
		bLine.Thickness = 1.5
		bLine.Transparency = 1
		table.insert(bones, bLine)
	end

	pack = {
		box = box,
		line = line,
		bones = bones,
		smoothRect = nil,
	}
	PlayerEspDrawings[plr] = pack
	return pack
end

local function HidePlayerEspPack(pack)
	if not pack then
		return
	end
	pack.smoothRect = nil
	if pack.box then
		pack.box.Visible = false
	end
	if pack.line then
		pack.line.Visible = false
	end
	if pack.bones then
		for _, b in ipairs(pack.bones) do
			b.Visible = false
		end
	end
end

local function UpdateVisualEspFrame(t)
	if not HasDrawingApi then
		return
	end
	if not EspBoxEnabled and not EspLineEnabled and not EspSkeletonEnabled then
		ClearAllEsp()
		return
	end

	local cam = workspace.CurrentCamera
	if not cam then
		return
	end

	local viewSize = cam.ViewportSize
	local lineOrigin = Vector2.new(viewSize.X * 0.5, viewSize.Y)

	for plr in pairs(PlayerEspDrawings) do
		if plr.Parent ~= Players or plr == LocalPlayer then
			ClearPlayerEsp(plr)
		end
	end

	for idx, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")

			local pack = GetOrCreatePlayerEsp(plr)
			if not char or char.Parent ~= workspace or (hum and hum.Health <= 0) then
				HidePlayerEspPack(pack)
			else
				local centerWorld, _, bottomWorld = GetCharacterBounds3D(char)
				if not centerWorld then
					HidePlayerEspPack(pack)
				else
					local ctrScreen, ctrVis = cam:WorldToViewportPoint(centerWorld)
					if ctrScreen.Z <= 0.05 and not ctrVis then
						HidePlayerEspPack(pack)
					else
						local rainbowCol = GetRainbowColorAt((t * 0.45) + (idx * 0.14))

						if EspBoxEnabled and pack.box then
							local rx, ry, rw, rh = ComputeCharacterBoxScreenRect(char, cam)
							if not rx then
								pack.smoothRect = nil
								pack.box.Visible = false
							else
								if not pack.smoothRect then
									pack.smoothRect = { x = rx, y = ry, w = rw, h = rh }
								else
									local sr = pack.smoothRect
									sr.x = sr.x + ((rx - sr.x) * BOX_SMOOTH_ALPHA)
									sr.y = sr.y + ((ry - sr.y) * BOX_SMOOTH_ALPHA)
									sr.w = sr.w + ((rw - sr.w) * BOX_SMOOTH_ALPHA)
									sr.h = sr.h + ((rh - sr.h) * BOX_SMOOTH_ALPHA)
								end

								local sr = pack.smoothRect
								pack.box.Size = Vector2.new(sr.w, sr.h)
								pack.box.Position = Vector2.new(sr.x, sr.y)
								pack.box.Color = rainbowCol
								pack.box.Visible = true
							end
						elseif pack.box then
							pack.smoothRect = nil
							pack.box.Visible = false
						end

						if EspLineEnabled and pack.line then
							local botScreen, botVis = cam:WorldToViewportPoint(bottomWorld)
							if botScreen.Z > 0.05 and (botVis or ctrVis) then
								pack.line.From = lineOrigin
								pack.line.To = Vector2.new(botScreen.X, botScreen.Y)
								pack.line.Color = rainbowCol
								pack.line.Visible = true
							else
								pack.line.Visible = false
							end
						elseif pack.line then
							pack.line.Visible = false
						end

						if EspSkeletonEnabled and pack.bones then
							local pairsList = char:FindFirstChild("UpperTorso") and SKELETON_PAIRS_R15 or SKELETON_PAIRS_R6
							for bIdx, bLine in ipairs(pack.bones) do
								local pair = pairsList[bIdx]
								local pA = pair and char:FindFirstChild(pair[1])
								local pB = pair and char:FindFirstChild(pair[2])
								if pA and pB and pA:IsA("BasePart") and pB:IsA("BasePart") then
									local boneDist = (pA.Position - pB.Position).Magnitude
									local nearCenter = (pA.Position - centerWorld).Magnitude <= 8 and (pB.Position - centerWorld).Magnitude <= 8
									if boneDist > 0.05 and boneDist <= 8 and nearCenter then
										local sA, vA = cam:WorldToViewportPoint(pA.Position)
										local sB, vB = cam:WorldToViewportPoint(pB.Position)
										if sA.Z > 0.05 and sB.Z > 0.05 and (vA or vB) then
											bLine.From = Vector2.new(sA.X, sA.Y)
											bLine.To = Vector2.new(sB.X, sB.Y)
											bLine.Color = Color3.fromRGB(255, 255, 255)
											bLine.Visible = true
										else
											bLine.Visible = false
										end
									else
										bLine.Visible = false
									end
								else
									bLine.Visible = false
								end
							end
						elseif pack.bones then
							for _, b in ipairs(pack.bones) do
								b.Visible = false
							end
						end
					end
				end
			end
		end
	end
end

