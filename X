local function IsCameraLockShouldBeActive()
	return AutoThrowEnabled and RemoveCharacterEnabled
end

local function ComputeThrowFrontLockCFrame(cam)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local zonePos = nil

	if CachedThrowCFrame then
		zonePos = CachedThrowCFrame.Position
	elseif SavedCharRootCFrame then
		zonePos = SavedCharRootCFrame.Position
	elseif hrp then
		zonePos = hrp.Position
	elseif cam then
		zonePos = cam.CFrame.Position
	end

	if not zonePos then
		return nil
	end

	local dir = GetCorridorDirection(cam)
	local camPos = zonePos - (dir * LOCK_BACK_DIST) + Vector3.new(0, LOCK_CAM_HEIGHT, 0)
	local lookTarget = zonePos + (dir * LOCK_LOOK_DIST) + Vector3.new(0, LOCK_FOCUS_HEIGHT, 0)
	return CFrame.lookAt(camPos, lookTarget)
end

local function NeutralizeBlackoutFrame(frameObj, vp)
	if not IsCameraLockShouldBeActive() or not frameObj or not frameObj.Parent or frameObj:IsDescendantOf(ScreenGui) then
		return
	end
	if not frameObj:IsA("GuiObject") or not frameObj.Visible then
		return
	end
	local bigEnough = (frameObj.Size.X.Scale >= 0.85 or frameObj.AbsoluteSize.X >= (vp.X * 0.8))
		and (frameObj.Size.Y.Scale >= 0.85 or frameObj.AbsoluteSize.Y >= (vp.Y * 0.8))
	if not bigEnough then
		return
	end
	local isFullScreenOverlay = false
	if frameObj:IsA("Frame") or frameObj:IsA("ImageLabel") or frameObj:IsA("TextLabel") then
		local c = frameObj.BackgroundColor3
		local isDark = (c.R <= 0.12 and c.G <= 0.12 and c.B <= 0.12)
		local nameLower = frameObj.Name:lower()
		local blackoutNamed = nameLower:find("black", 1, true)
			or nameLower:find("fade", 1, true)
			or nameLower:find("transition", 1, true)
			or nameLower:find("loading", 1, true)
			or nameLower:find("blur", 1, true)
			or nameLower:find("overlay", 1, true)
			or nameLower:find("vignette", 1, true)
			or nameLower:find("flash", 1, true)
		local hasLowTransp = (frameObj.BackgroundTransparency < 0.75)
			or (frameObj:IsA("ImageLabel") and frameObj.ImageTransparency < 0.75 and frameObj.Image ~= "")
		if hasLowTransp and (isDark or blackoutNamed) then
			isFullScreenOverlay = true
		end
	end
	if isFullScreenOverlay then
		if HiddenBlackoutGuis[frameObj] == nil then
			HiddenBlackoutGuis[frameObj] = {
				Visible = frameObj.Visible,
				BackgroundTransparency = frameObj.BackgroundTransparency,
				ImageTransparency = frameObj:IsA("ImageLabel") and frameObj.ImageTransparency or nil,
			}
		end
		frameObj.BackgroundTransparency = 1
		if frameObj:IsA("ImageLabel") then
			frameObj.ImageTransparency = 1
		end
		frameObj.Visible = false
	end
end

local function PreventBlackScreenOverlays(force)
	if not IsCameraLockShouldBeActive() then
		return
	end
	local now = os.clock()
	if not force and (now - LastBlackoutScan) < 0.75 then
		return
	end
	LastBlackoutScan = now

	local cam = workspace.CurrentCamera
	local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		for _, desc in ipairs(pg:GetDescendants()) do
			if desc:IsA("GuiObject") and not desc:IsDescendantOf(ScreenGui) then
				NeutralizeBlackoutFrame(desc, vp)
			end
		end
	end
end

local function AttachBlackoutWatcher()
	for _, conn in ipairs(BlackoutWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	BlackoutWatchConns = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		table.insert(BlackoutWatchConns, pg.DescendantAdded:Connect(function(desc)
			if IsCameraLockShouldBeActive() and desc:IsA("GuiObject") and not desc:IsDescendantOf(ScreenGui) then
				local cam = workspace.CurrentCamera
				local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
				NeutralizeBlackoutFrame(desc, vp)
			end
		end))
	end
end

local function RestoreBlackScreenOverlays()
	for _, conn in ipairs(BlackoutWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	BlackoutWatchConns = {}
	for guiObj, prev in pairs(HiddenBlackoutGuis) do
		if guiObj and guiObj.Parent then
			pcall(function()
				guiObj.BackgroundTransparency = prev.BackgroundTransparency
				if prev.ImageTransparency ~= nil and guiObj:IsA("ImageLabel") then
					guiObj.ImageTransparency = prev.ImageTransparency
				end
				guiObj.Visible = prev.Visible
			end)
		end
	end
	HiddenBlackoutGuis = {}
end

local function ClearCameraWatchers()
	for _, conn in ipairs(CameraWatchConns) do
		pcall(function()
			conn:Disconnect()
		end)
	end
	CameraWatchConns = {}
end

local function EnforceLockedCamera()
	if not IsCameraLockShouldBeActive() then
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if not LockedCameraCFrame then
		LockedCameraCFrame = ComputeThrowFrontLockCFrame(cam)
	end
	if not LockedCameraCFrame then
		return
	end
	if not LockedCameraFOV or LockedCameraFOV <= 1 then
		LockedCameraFOV = (cam.FieldOfView > 1) and cam.FieldOfView or 70
	end
	if cam.CameraType ~= Enum.CameraType.Scriptable then
		cam.CameraType = Enum.CameraType.Scriptable
	end
	if cam.FieldOfView ~= LockedCameraFOV then
		cam.FieldOfView = LockedCameraFOV
	end
	cam.CFrame = LockedCameraCFrame
	cam.Focus = LockedCameraCFrame
end

local function AttachCameraWatchers(cam)
	ClearCameraWatchers()
	if not cam then
		return
	end
	table.insert(CameraWatchConns, cam:GetPropertyChangedSignal("CameraType"):Connect(function()
		if IsCameraLockShouldBeActive() and cam.CameraType ~= Enum.CameraType.Scriptable then
			cam.CameraType = Enum.CameraType.Scriptable
			if LockedCameraCFrame then
				cam.CFrame = LockedCameraCFrame
				cam.Focus = LockedCameraCFrame
			end
		end
	end))
	table.insert(CameraWatchConns, cam:GetPropertyChangedSignal("CFrame"):Connect(function()
		if IsCameraLockShouldBeActive() and LockedCameraCFrame and cam.CFrame ~= LockedCameraCFrame then
			cam.CameraType = Enum.CameraType.Scriptable
			cam.CFrame = LockedCameraCFrame
			cam.Focus = LockedCameraCFrame
		end
	end))
	table.insert(CameraWatchConns, cam:GetPropertyChangedSignal("FieldOfView"):Connect(function()
		if IsCameraLockShouldBeActive() and LockedCameraFOV and cam.FieldOfView ~= LockedCameraFOV then
			cam.FieldOfView = LockedCameraFOV
		end
	end))
	table.insert(CameraWatchConns, workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		if IsCameraLockShouldBeActive() then
			local newCam = workspace.CurrentCamera
			if newCam then
				newCam.CameraType = Enum.CameraType.Scriptable
				if LockedCameraFOV then
					newCam.FieldOfView = LockedCameraFOV
				end
				if LockedCameraCFrame then
					newCam.CFrame = LockedCameraCFrame
					newCam.Focus = LockedCameraCFrame
				end
				AttachCameraWatchers(newCam)
			end
		end
	end))
end

local function RestoreCameraLock()
	LockedCameraCFrame = nil
	LockedCameraFOV = nil
	LastBlackoutScan = 0
	ClearCameraWatchers()
	RestoreBlackScreenOverlays()
	if CameraLockBound then
		CameraLockBound = false
		pcall(function()
			RunService:UnbindFromRenderStep(CAMERA_BIND_NAME)
		end)
	end
	local cam = workspace.CurrentCamera
	if cam then
		pcall(function()
			cam.CameraType = Enum.CameraType.Custom
			local char = LocalPlayer.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
		end)
	end
end

local function CaptureCameraLock()
	if not IsCameraLockShouldBeActive() then
		RestoreCameraLock()
		return
	end
	local cam = workspace.CurrentCamera
	if not cam then
		return
	end
	if not CORRIDOR_DIR then
		CORRIDOR_DIR = GetCorridorDirection(cam)
	end
	LockedCameraCFrame = ComputeThrowFrontLockCFrame(cam)
	if not LockedCameraCFrame then
		local pos = cam.CFrame.Position
		LockedCameraCFrame = CFrame.lookAt(pos, pos + GetCorridorDirection(cam))
	end
	LockedCameraFOV = (cam.FieldOfView > 1) and cam.FieldOfView or 70
	cam.CameraType = Enum.CameraType.Scriptable
	cam.FieldOfView = LockedCameraFOV
	cam.CFrame = LockedCameraCFrame
	cam.Focus = LockedCameraCFrame
	AttachCameraWatchers(cam)
	AttachBlackoutWatcher()
	PreventBlackScreenOverlays(true)
	if not CameraLockBound then
		CameraLockBound = true
		RunService:BindToRenderStep(CAMERA_BIND_NAME, Enum.RenderPriority.Last.Value + 50, EnforceLockedCamera)
	end
end

local function SyncCameraLockState()
	if IsCameraLockShouldBeActive() then
		CaptureCameraLock()
	else
		RestoreCameraLock()
	end
end

