local function ClearPlayerEsp(plr)
	local pack = PlayerEspDrawings[plr]
	if not pack then
		return
	end
	if pack.box then
		pcall(function()
			pack.box:Remove()
		end)
	end
	if pack.line then
		pcall(function()
			pack.line:Remove()
		end)
	end
	if pack.bones then
		for _, b in ipairs(pack.bones) do
			pcall(function()
				b:Remove()
			end)
		end
	end
	PlayerEspDrawings[plr] = nil
end

local function ClearAllEsp()
	for plr in pairs(PlayerEspDrawings) do
		ClearPlayerEsp(plr)
	end
end

