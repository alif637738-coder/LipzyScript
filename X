local function FireSkipReflexNow(skipGui)
	if not AutoThrowEnabled or not SkipAnimationEnabled then
		return
	end

	local now = os.clock()
	if (now - LastReflexSkipTime) < REFLEX_SKIP_COOLDOWN then
		return
	end
	LastReflexSkipTime = now
	LastTriggerTime = now

	RefreshPromptCacheLight(false)
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	FireThrowProximityPrompts(hrp, CachedThrowCFrame)

	local x, y = nil, nil
	if skipGui and skipGui:IsA("GuiObject") and skipGui.AbsoluteSize.X > 0 and skipGui.AbsoluteSize.Y > 0 then
		x = skipGui.AbsolutePosition.X + (skipGui.AbsoluteSize.X * 0.5)
		y = skipGui.AbsolutePosition.Y + (skipGui.AbsoluteSize.Y * 0.5)
		local btn = ResolveClickableGui(skipGui)
		FireGuiButtonConnections(btn)
		if skipGui.Parent and skipGui.Parent:IsA("GuiButton") then
			FireGuiButtonConnections(skipGui.Parent)
		end
	end

	local cam = workspace.CurrentCamera
	if cam then
		local clickX = x or (cam.ViewportSize.X * 0.5)
		local clickY = y or (cam.ViewportSize.Y * 0.5)
		SilentBackgroundClick(clickX, clickY)
	end
end

local function RegisterSkipCandidate(obj)
	if not obj or HookedSkipObjects[obj] then
		return
	end
	if not (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
		return
	end
	if obj.Name == "Title" or obj:IsDescendantOf(ScreenGui) then
		return
	end

	HookedSkipObjects[obj] = true

	local function EvaluateObj(triggerImmediately)
		if not obj.Parent then
			return
		end
		if GetSkipPhase(obj.Text) > 0 then
			if not table.find(WatchedSkipLabels, obj) then
				table.insert(WatchedSkipLabels, obj)
			end
			if triggerImmediately and AutoThrowEnabled and SkipAnimationEnabled and IsGuiActuallyVisible(obj) then
				FireSkipReflexNow(obj)
			end
		end
	end

	EvaluateObj(true)
	pcall(function()
		obj:GetPropertyChangedSignal("Text"):Connect(function()
			EvaluateObj(true)
		end)
		obj:GetPropertyChangedSignal("Visible"):Connect(function()
			EvaluateObj(true)
		end)
	end)
end

local function SeedSkipWatchlist(force)
	local now = os.clock()
	if not force and (now - LastSkipSeedScan) < 1.5 then
		return
	end
	LastSkipSeedScan = now

	local roots = {}
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if pg then
		table.insert(roots, pg)
	end
	pcall(function()
		if CoreGui then
			table.insert(roots, CoreGui)
		end
	end)

	for _, root in ipairs(roots) do
		pcall(function()
			for _, desc in ipairs(root:GetDescendants()) do
				RegisterSkipCandidate(desc)
			end
		end)
	end
end

local function HookGuiRoots()
